# Base URL of the Blue Team ML API (red-team01/sentinelpay/blue_team_api.py).
# Falls back to the deployed instance (https://blueteam01.onrender.com) when unset, so
# the app works with no local backend running. Override only to point at a locally-run
# instance, fixed dev port 8011: red-team01/sentinelpay/start.bat.
VITE_API_BASE_URL=https://blueteam01.onrender.com

# Base URL for the Threat Analyzer Chatbot backend (blue_team_fraud_engine/main.py).
# This is a SEPARATE service from VITE_API_BASE_URL above - blue_team_api.py has no
# chat/RAG endpoint. Falls back to the deployed instance
# (https://fraudshield-chatbot.onrender.com) when unset, so the chatbot works with no
# local backend running. Override only to point at a locally-run instance, fixed dev
# port 8012: blue_team_fraud_engine/start.bat.
VITE_CHAT_API_BASE_URL=https://fraudshield-chatbot.onrender.com

# Supabase project URL and public anon key (Project Settings -> API in the Supabase
# dashboard). The anon key is safe to expose in frontend bundles - it's restricted by
# Row Level Security policies on the tables it can reach.
VITE_SUPABASE_URL=https://ddkpincnsbjuspgotyec.supabase.co
VITE_SUPABASE_ANON_KEY=
