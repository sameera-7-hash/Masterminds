# Base URL of the Blue Team ML API (red-team01/sentinelpay/blue_team_api.py).
# Fixed local dev port: 8011. Run it with red-team01/sentinelpay/start.bat.
VITE_API_BASE_URL=http://localhost:8011

# Base URL for the Threat Analyzer Chatbot backend (blue_team_fraud_engine/main.py).
# This is a SEPARATE service from VITE_API_BASE_URL above - blue_team_api.py has no
# chat/RAG endpoint. Falls back to the deployed instance
# (https://fraudshield-chatbot.onrender.com) when unset, so the chatbot works with no
# local backend running. Override only to point at a locally-run instance, fixed dev
# port 8012: blue_team_fraud_engine/start.bat.
VITE_CHAT_API_BASE_URL=https://fraudshield-chatbot.onrender.com
